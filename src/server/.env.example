PORT=3000

# Public tunnel/deployment host without a path. Both forms are accepted:
# HOSTNAME=example.trycloudflare.com
# HOSTNAME=https://example.trycloudflare.com
HOSTNAME=

# Comma-separated browser origins allowed to call this server.
# Use * for local testing. For production, use your custom domain origin(s).
# Trailing slashes are normalized, and icp0.io/ic0.app equivalents are allowed.
FRONTEND_ORIGIN=https://voicecallai.online,https://www.voicecallai.online,https://2nukr-cyaaa-aaaak-qy2ja-cai.icp0.io
FRONTEND_URL=https://voicecallai.online
CORS_ALLOWED_ORIGINS=

# Optional fallback: set canister IDs and the server will allow both
# https://<id>.icp0.io and https://<id>.ic0.app.
FRONTEND_CANISTER_ID=2nukr-cyaaa-aaaak-qy2ja-cai

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

XAI_API_KEY=
# Pin Think Fast 2.0 in production. Use grok-voice-latest only if you
# intentionally want future xAI voice upgrades without a code/config change.
XAI_MODEL=grok-voice-think-fast-2.0
XAI_VOICE=eve
XAI_DEFAULT_REASONING_EFFORT=high
XAI_DEFAULT_IDLE_TIMEOUT_MS=14000
XAI_DEFAULT_SPEECH_SPEED=1
XAI_SESSION_RESUMPTION=true

# Voice metadata is cached to avoid repeated xAI API calls.
XAI_VOICE_LIBRARY_CACHE_MS=900000

# ICP backend used as the source of truth for balances and call reservations.
BACKEND_CANISTER_ID=2dwhz-ziaaa-aaaak-qy2ia-cai
BACKEND_HOST=https://icp-api.io

# Polls the canister's bounded MCP call queue. The poll is a query; update
# calls are made only when a queued job is actually claimed or finalized.
AGENT_CALL_POLL_INTERVAL_MS=10000
AGENT_CALL_POLL_LIMIT=10

# Generate with:
# node src/server/scripts/create-ic-server-identity.mjs
# Verify with: pnpm server:check-identity
# Then use an existing browser admin to grant the printed principal admin access.
ICP_SERVER_IDENTITY_JSON=

# Stripe Checkout. Admin users receive test-mode Checkout Sessions; normal
# users receive live-mode Checkout Sessions.
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...
STRIPE_LIVE_SECRET_KEY=sk_live_...
STRIPE_LIVE_WEBHOOK_SECRET=whsec_...

# Optional Stripe Price IDs. If omitted, the server creates inline Checkout
# prices for the fixed packages: $5/30m, $10/60m, $20/120m.
STRIPE_TEST_PRICE_5=
STRIPE_TEST_PRICE_10=
STRIPE_TEST_PRICE_20=
STRIPE_LIVE_PRICE_5=
STRIPE_LIVE_PRICE_10=
STRIPE_LIVE_PRICE_20=

# Required in production. You may temporarily set false only for local testing.
VALIDATE_TWILIO_SIGNATURE=true

# Dedicated HMAC secrets for recording playback links. Do not reuse Twilio,
# xAI, ICP identity, or Stripe secrets here.
RECORDING_ACCESS_SECRET=
BRIDGE_RECORDING_ACCESS_SECRET=

# Answering-service (bridge) recordings are stored on the voice host disk so
# they survive process restarts. Keep this path on persistent local storage.
# Default: <server-dir>/data/bridge-recordings
# BRIDGE_RECORDING_DIR=C:\Projects\voicecall-ai\src\server\data\bridge-recordings
# Retention window (default 30 days). Lower to save disk; higher for longer history.
# BRIDGE_RECORDING_TTL_MS=2592000000

# Optional first turn for outbound calls.
CALL_GREETING=The phone call is now connected. Briefly introduce yourself and ask how you can help.
